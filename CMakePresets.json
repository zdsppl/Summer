{
  "version": 6,
  "configurePresets": [
      {
          "name": "wesql-configure",
          "hidden": false,
          "description": "CMake configuration for wesql-server",
          "binaryDir": "${workspaceFolder}/build",
          "generator": "Unix Makefiles",
          "cacheVariables": {
              "CMAKE_BUILD_TYPE": "Debug",
              "CMAKE_C_COMPILER": "/opt/rh/gcc-toolset-11/root/usr/bin/gcc",
              "CMAKE_CXX_COMPILER": "/opt/rh/gcc-toolset-11/root/usr/bin/g++",
              "CMAKE_INCLUDE_PATH": "/opt/rh/gcc-toolset-11/root/usr/lib/gcc/x86_64-redhat-linux/11/include/",
              "WITH_ROUTER": "false",
              "WITH_FAIL_POINT": "true",
              "WITH_WESQL_TEST": "true",
              "WITH_BOOST": "${workspaceFolder}/extra/boost_1_77_0.tar.bz2",
              "CMAKE_EXPORT_COMPILE_COMMANDS": "true"
          }
      }
